# Hermes Agent configuration for the ActiveTigger Documentation Assistant.
# Copy to ~/.hermes/.env on the server and fill in the secrets.
# Variable names follow Hermes' reference:
# https://hermes-agent.nousresearch.com/docs/reference/environment-variables
#
# NOTE: mail configuration does NOT live here. The mail provider selection
# and its credentials are in a dedicated file read only by the deterministic
# scripts: see mail-credentials.env.example (deployed to
# ~/.hermes/mail-credentials.env by Scripts/install.sh).

# --- Model / inference (Ilaas, OpenAI-compatible endpoint) ---
OPENAI_BASE_URL=https://your-ilaas-endpoint.example.org/v1
OPENAI_API_KEY=changeme
# Model served by the endpoint (overrides config.yaml):
HERMES_INFERENCE_MODEL=changeme
