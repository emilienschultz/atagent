# Mail provider configuration + credentials for the ActiveTigger agent
# scripts (Scripts/*.py). Copy to ~/.hermes/mail-credentials.env on the
# server, fill in the secrets, and restrict it: chmod 600.
#
# This file is read ONLY by the deterministic scripts — the agent itself
# never opens it. It is separate from the Hermes .env so the whole mail
# stack can be swapped or rotated without touching the agent runtime.
# Override its location with $AT_CREDENTIALS_FILE (mainly for testing).

# Which provider implementation to use (see Scripts/mail_provider.py).
# Known providers: agentmail. Adding one = a new provider_<name>.py.
MAIL_PROVIDER=agentmail

# The inbox address the agent answers from (provider-neutral).
EMAIL_ADDRESS=activetigger@agentmail.to

# Sender allowlist, enforced deterministically by check_mail.py: emails
# from other senders are retired (outcome skipped-sender) without the
# agent ever seeing them. Leave empty to process every sender (open
# inbox — POC mode).
EMAIL_ALLOWED_USERS=alice@example.org,bob@example.org

# --- agentmail provider ------------------------------------------------------
# API key for https://api.agentmail.to (Bearer token); AgentMail uses the
# same value as the SMTP password.
AGENTMAIL_API_KEY=changeme
AGENTMAIL_SMTP_HOST=smtp.agentmail.to
AGENTMAIL_SMTP_PORT=465

# --- optional ----------------------------------------------------------------
# Data directory for state + audit logs (default ~/work/atagent):
#AT_DATA_DIR=~/work/atagent
